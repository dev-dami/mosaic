# Environment for a public Scout behind deploy/Caddyfile. Copy to scout.env, replace the example
# names, and start Scout with it (for example: set -a; . deploy/scout.env; bun agent/scout.ts).
# 203-0-113-10.sslip.io is a placeholder; use the name that resolves to your server.

PORT=4108
# Scout's own public origin (the scout.<domain> block in the Caddyfile).
PUBLIC_ORIGIN=https://scout.203-0-113-10.sslip.io
# Mosaic hosts that may call Scout, comma separated (checked on the Origin header).
MOSAIC_HOSTS=https://mosaic-host.example.com
# Sites Scout may open, comma separated, exact origins. Without this Scout opens loopback only.
SCOUT_TARGETS=https://corkboard.example.com
# Adapter ports 4110-4129, one Caddyfile block each. {port} is the adapter's port.
SCOUT_ADAPTER_PORT_BASE=4110
SCOUT_MAX_ADAPTERS=20
SCOUT_ADAPTER_ORIGIN=https://scout-{port}.203-0-113-10.sslip.io
# Templates persist here between restarts.
SCOUT_DIR=/var/lib/scout
# Chromium for playwright-core.
CHROMIUM_PATH=/root/.cache/ms-playwright/chromium-1254/chrome-linux64/chrome
# Optional: learn with Claude instead of rules. Put the key in a secret store, not in this file.
# ANTHROPIC_API_KEY=
