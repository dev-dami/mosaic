# Podman quadlet for Caddy in front of Scout (deploy/Caddyfile, automatic HTTPS). Copy to
# /etc/containers/systemd/ with mosaic-scout.container. 64 MB of the 512 MB budget.
[Unit]
Description=Caddy for Mosaic Scout
After=network-online.target srv-mosaic.mount
Requires=srv-mosaic.mount

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=mosaic-caddy
Network=host
EnvironmentFile=/etc/mosaic/caddy.env
Volume=/etc/mosaic/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=/srv/mosaic/caddy:/data:Z
Volume=/srv/mosaic/caddy-config:/config:Z
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
PodmanArgs=--memory=64m --memory-swap=64m --pids-limit=256

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
