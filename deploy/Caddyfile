# Caddy in front of a public Scout (agent/scout.ts). Automatic HTTPS: Caddy gets a Let's Encrypt
# certificate for each hostname below. SCOUT_DOMAIN is a name that resolves to this server, for
# example 203-0-113-10.sslip.io (sslip.io answers with the IP written in the name). Run Caddy with
# SCOUT_DOMAIN in its environment (systemd: Environment=SCOUT_DOMAIN=...).
#
# Scout listens on 4108 and serves learned adapters on 4110-4129 (SCOUT_ADAPTER_PORT_BASE=4110,
# SCOUT_MAX_ADAPTERS=20). With SCOUT_ADAPTER_ORIGIN=https://scout-{port}.<SCOUT_DOMAIN>, each adapter
# gets the hostname below that names its port. Keep 4108-4129 closed in the firewall; only 80 and
# 443 face the internet. Matching Scout settings: deploy/scout.env.example.

scout.{$SCOUT_DOMAIN} {
	reverse_proxy 127.0.0.1:4108
}

scout-4110.{$SCOUT_DOMAIN} {
	reverse_proxy 127.0.0.1:4110
}
scout-4111.{$SCOUT_DOMAIN} {
	reverse_proxy 127.0.0.1:4111
}
