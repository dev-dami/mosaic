{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mosaic.dev/spec/capabilities-v0.schema.json",
  "title": "Mosaic capability manifest v0",
  "description": "Served by a site at /.well-known/mosaic-capabilities.json. Capability fields follow the WebAgentica tool declaration (agent.pkg 0.1) where they overlap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mosaic", "site", "bridge", "capabilities"],
  "properties": {
    "mosaic": { "const": "capabilities/0" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "origin"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "origin": { "type": "string", "pattern": "^https?://[^/]+$" },
        "description": { "type": "string", "maxLength": 500 },
        "theme_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "The site's brand colour, as in the Web App Manifest. The host takes its hue for the site's identity mark and may move it away from other sites' hues." }
      }
    },
    "bridge": { "type": "string", "pattern": "^/[^/]" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "side_effects", "input_schema", "output_schema"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "side_effects": { "enum": ["read", "write"] },
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" }
        }
      }
    }
  }
}
